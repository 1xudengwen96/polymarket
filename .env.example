# ──────────────────────────────────────────────────────────────
# pm5hft 环境变量示例 —— 复制为 .env 并填入真实值。
# 敏感信息（私钥/API 凭证）绝不硬编码、绝不提交 git。
# ──────────────────────────────────────────────────────────────

# 运行模式：paper（默认，无真实资金）| live（需下方私钥 + live.yaml allow_live:true）
PM5HFT_MODE=paper
PM5HFT_LIVE=false

# 数据库（开发默认 SQLite；生产用 Docker 内 TimescaleDB 时改为 postgresql+psycopg://…）
PM5HFT_DB_URL=sqlite+aiosqlite:///./data/pm5hft.db

# 日志
PM5HFT_LOG_LEVEL=INFO

# 资产列表（逗号分隔；Phase1 仅 btc）
PM5HFT_ASSETS=btc

# ── 实盘账户（仅 LIVE 需要）──────────────────────────────────
# Polygon L2 签名钱包私钥（0x 开头 64 hex）
POLYMARKET_PRIVATE_KEY=
# 代理钱包（email/Magic 钱包等）的资金地址；EOA 直接签名可留空
POLYMARKET_FUNDER=
# 签名类型: 0=EOA, 1=POLY_PROXY, 2=GNOSIS_SAFE
POLYMARKET_SIGNATURE_TYPE=1
# 可选：手动提供 API 凭证（留空则由 SDK 用私钥派生）
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# ── 可选：Chainlink Data Streams 直连凭证（更高精度 TWAP，可选升级）──
CHAINLINK_CLIENT_ID=
CHAINLINK_CLIENT_SECRET=
